# Store and check out text files with LF endings on every OS.
# Without this, Windows converts to CRLF and Prettier/CI report every file as changed.
* text=auto eol=lf

# cmd.exe misreads batch files with LF-only endings (labels, goto, and long lines break).
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.webp binary
*.glb binary
*.woff2 binary
