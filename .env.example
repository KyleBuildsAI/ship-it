# Copy this file to .env and fill in values on your machine only.
# .env is gitignored. Never commit real values.
# A blank value means "use the default" listed above it.

# Anthropic API key for the Sage mentor server. Server-side only, never in client code.
# Without it the game still works: Sage shows "offline" and pre-written hints take over.
ANTHROPIC_API_KEY=

# Model for hint, grade_question, and explain modes. Default: claude-sonnet-5.
MENTOR_MODEL_DEFAULT=

# Model for interview mode (M5). Default: claude-opus-5-5.
MENTOR_MODEL_INTERVIEW=

# Hard stop: maximum mentor API calls per day. Default: 50. 0 switches Sage off.
MENTOR_DAILY_CALL_CAP=

# Port the Sage server listens on (127.0.0.1 only). Vite's /api proxy reads it too. Default: 8787.
MENTOR_PORT=

# NOT SUPPORTED YET: the server ignores this and prints a warning. Meant to route mentor calls
# through an Anthropic-compatible gateway (such as a LiteLLM proxy) once it's confirmed to
# expose the Anthropic Messages API. See DESIGN.md section 9.
MENTOR_BASE_URL=
