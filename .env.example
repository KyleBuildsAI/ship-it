# Copy this file to .env and fill in values on your machine only.
# .env is gitignored. Never commit real values.

# Anthropic API key for the Sage mentor server. Server-side only, never in client code.
ANTHROPIC_API_KEY=

# Model used for hint, grade_question, and explain modes (e.g. claude-sonnet-5).
MENTOR_MODEL_DEFAULT=

# Model used for interview mode (e.g. claude-opus-5-5).
MENTOR_MODEL_INTERVIEW=

# Hard stop: maximum mentor API calls per day.
MENTOR_DAILY_CALL_CAP=

# Optional: route mentor calls through an Anthropic-compatible gateway. Leave empty to call Anthropic directly.
MENTOR_BASE_URL=
